# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright / e2e
/test-results
/playwright-report
/playwright/.cache
/e2e/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never committed, but the documented example IS
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
/supabase/.temp
/supabase/.branches

# claude — machine-specific local permissions only; the personas & settings.json ARE committed
/.claude/settings.local.json

# eval reports (committed baselines are force-added)
/eval/reports

# fetched corpus text — ADR-003: the repo ships the manifest and the pipeline,
# never the text. corpus/manifest.lock.yaml and corpus/errata/ ARE committed:
# they carry locators, hashes and counts, and no corpus text.
/.corpus-cache

# python harness (ADR-023). uv.lock IS committed — the whole point of the
# harness is reproducible measurement, and an unpinned dependency set makes an
# eval report's provenance a claim rather than a fact.
/harness/.venv
__pycache__/
*.py[cod]
/harness/.ruff_cache
/harness/.mypy_cache
/harness/.pytest_cache
