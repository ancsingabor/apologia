# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's current name for the anon/publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Resend (transactional email) ─────────────────────────────────────────────
# Outbound only. Keep this a `noreply@` on the project's domain — the app sends,
# it never receives. Where a human reply goes is `brand.replyToEmail` in
# config/brand.ts, not here. See docs/email-boundary.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Optional: Vercel Cron (only if you enable a cron route — see README) ──────
# CRON_SECRET=
