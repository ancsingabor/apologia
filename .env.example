# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's current name for the anon/publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI providers ─────────────────────────────────────────────────────────────
# Answer generation.
ANTHROPIC_API_KEY=
# Embeddings. Provider is not yet decided — it is chosen by measuring candidates
# on the gold set rather than from model cards. See docs/adr/README.md (ADR-008).
EMBEDDING_API_KEY=

# ── Notes ────────────────────────────────────────────────────────────────────
# The ingestion CLI needs SUPABASE_SERVICE_ROLE_KEY and EMBEDDING_API_KEY.
# The deployed app does not — ingestion is an operator task, not a request path
# (docs/adr/004-offline-ingestion-cli.md). Scope the deployment's env accordingly.
