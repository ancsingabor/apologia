# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's current name for the anon/publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── The measurement harness ──────────────────────────────────────────────────
# A direct Postgres connection string, used ONLY by harness/ (ADR-023). The
# bake-off writes ~9,183 vectors per candidate and the scorer orders by
# pgvector's `<=>`; PostgREST does neither well, so the harness does not go
# through the Supabase client.
#
# `DB_URL` is the name `supabase status -o env` prints, so a local run needs no
# .env entry at all — see harness/README.md. A non-local target is refused
# unless the operator passes --remote.
DB_URL=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI providers ─────────────────────────────────────────────────────────────
# Answer generation.
ANTHROPIC_API_KEY=
# Embeddings. Provider is not yet decided — it is chosen by measuring candidates
# on the gold set rather than from model cards. See docs/adr/README.md (ADR-008).
EMBEDDING_API_KEY=

# ── Notes ────────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY is operator-only: the ingestion CLI and eval:lint
# use it, the deployed app never does (docs/adr/004-offline-ingestion-cli.md).
# EMBEDDING_API_KEY is NOT operator-only, whatever ADR-004 once said: the query
# path embeds the user's question at request time, with the same model that
# embedded the corpus (docs/adr/023-python-at-the-measurement-boundary.md). It
# is needed by the deployed app only if a hosted API wins ADR-008; an
# open-weights winner needs no key at all. Scope the deployment's env accordingly.
